# هذا الملف اختياري: يُستخدم فقط إذا حبيت تجرب الموقع محلياً على جهازك
# قبل رفعه على GitHub (عبر: bundle install && bundle exec jekyll serve).
# GitHub Pages نفسه لا يحتاج هذا الملف أبداً ليعمل — يبني الموقع تلقائياً بمجرد الرفع.

source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
